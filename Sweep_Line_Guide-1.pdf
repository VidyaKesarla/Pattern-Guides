BT 1 0 0 1 4 159.8 Tm /F5 8.2 Tf 10.5 TL (public int minMeetingRoomsDelta\(int[][] intervals\) {) Tj T* (    List<int[]> events = new ArrayList<>\(\); // {time, delta}) Tj T* (    for \(int[] iv : intervals\) {) Tj T* (        events.add\(new int[]{iv[0], 1}\);   // start: +1 active) Tj T* (        events.add\(new int[]{iv[1], -1}\);  // end:   -1 active) Tj T* (    }) Tj T* (    // Sort by time; if tie, process ends \(-1\) before starts \(+1\)) Tj T* (    events.sort\(\(a, b\) -> a[0] != b[0] ? a[0] - b[0] : a[1] - b[1]\);) Tj T*  T* (    int active = 0, maxActive = 0;) Tj T* (    for \(int[] ev : events\) {) Tj T* (        active += ev[1];) Tj T* (        maxActive = Math.max\(maxActive, active\);) Tj T* (    }) Tj T* (    return maxActive;) Tj T* (}) Tj T* ET
