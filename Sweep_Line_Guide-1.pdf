BT 1 0 0 1 4 254.3 Tm /F5 8.2 Tf 10.5 TL (public int minMeetingRooms\(int[][] intervals\) {) Tj T* (    int n = intervals.length;) Tj T* (    int[] starts = new int[n];) Tj T* (    int[] ends = new int[n];) Tj T* (    for \(int i = 0; i < n; i++\) {) Tj T* (        starts[i] = intervals[i][0];) Tj T* (        ends[i] = intervals[i][1];) Tj T* (    }) Tj T* (    Arrays.sort\(starts\);) Tj T* (    Arrays.sort\(ends\);) Tj T*  T* (    int rooms = 0, maxRooms = 0;) Tj T* (    int s = 0, e = 0;) Tj T* (    while \(s < n\) {) Tj T* (        if \(starts[s] < ends[e]\) {   // a meeting starts before another ends) Tj T* (            rooms++;) Tj T* (            s++;) Tj T* (        } else {                     // a meeting ends, free a room) Tj T* (            rooms--;) Tj T* (            e++;) Tj T* (        }) Tj T* (        maxRooms = Math.max\(maxRooms, rooms\);) Tj T* (    }) Tj T* (    return maxRooms;) Tj T* (}) Tj T* ET
