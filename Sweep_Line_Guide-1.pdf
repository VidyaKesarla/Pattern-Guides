BT 1 0 0 1 4 117.8 Tm /F5 8.2 Tf 10.5 TL (public boolean canAttendAll\(int[][] intervals\) {) Tj T* (    Arrays.sort\(intervals, \(a, b\) -> a[0] - b[0]\); // sort by start) Tj T* (    PriorityQueue<Integer> endTimes = new PriorityQueue<>\(\); // min-heap of end times) Tj T*  T* (    for \(int[] iv : intervals\) {) Tj T* (        if \(!endTimes.isEmpty\(\) && endTimes.peek\(\) <= iv[0]\) {) Tj T* (            endTimes.poll\(\); // free up the room that already ended) Tj T* (        }) Tj T* (        endTimes.offer\(iv[1]\);) Tj T* (    }) Tj T* (    return endTimes.size\(\) <= 1; // or compare against room capacity) Tj T* (}) Tj T* ET
