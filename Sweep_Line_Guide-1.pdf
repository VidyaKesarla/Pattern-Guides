BT 1 0 0 1 4 149.3 Tm /F5 8.2 Tf 10.5 TL (public int[] applyRangeUpdates\(int n, int[][] updates\) {) Tj T* (    int[] diff = new int[n + 1];) Tj T* (    for \(int[] u : updates\) {) Tj T* (        int l = u[0], r = u[1], val = u[2];) Tj T* (        diff[l] += val;) Tj T* (        diff[r + 1] -= val; // cancels the effect after r) Tj T* (    }) Tj T* (    int[] result = new int[n];) Tj T* (    int running = 0;) Tj T* (    for \(int i = 0; i < n; i++\) {) Tj T* (        running += diff[i];) Tj T* (        result[i] = running;) Tj T* (    }) Tj T* (    return result;) Tj T* (}) Tj T* ET
Q
 

