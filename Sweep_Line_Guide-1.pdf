BT 1 0 0 1 4 128.3 Tm /F5 8.2 Tf 10.5 TL (public int maxOverlapCompressed\(int[][] intervals\) {) Tj T* (    TreeMap<Integer, Integer> deltaMap = new TreeMap<>\(\); // sorted by coordinate) Tj T* (    for \(int[] iv : intervals\) {) Tj T* (        deltaMap.merge\(iv[0], 1, Integer::sum\);) Tj T* (        deltaMap.merge\(iv[1], -1, Integer::sum\);) Tj T* (    }) Tj T* (    int active = 0, maxActive = 0;) Tj T* (    for \(int delta : deltaMap.values\(\)\) { // TreeMap iterates in sorted key order) Tj T* (        active += delta;) Tj T* (        maxActive = Math.max\(maxActive, active\);) Tj T* (    }) Tj T* (    return maxActive;) Tj T* (}) Tj T* ET
Q
