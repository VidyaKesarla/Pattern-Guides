BT 1 0 0 1 6 104.6 Tm /F3 7.6 Tf 10.2 TL (public int maxSumFixedWindow\(int[] nums, int k\) {) Tj T* (    int windowSum = 0;) Tj T* (    for \(int i = 0; i < k; i++\) windowSum += nums[i]; // build initial window) Tj T* (    int maxSum = windowSum;) Tj T*  T* (    for \(int right = k; right < nums.length; right++\) {) Tj T* (        windowSum += nums[right] - nums[right - k]; // slide: add new, remove oldest) Tj T* (        maxSum = Math.max\(maxSum, windowSum\);) Tj T* (    }) Tj T* (    return maxSum;) Tj T* (}) Tj T* ET
