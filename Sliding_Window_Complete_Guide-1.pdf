BT 1 0 0 1 6 308.6 Tm /F3 7.6 Tf 10.2 TL (public String minWindow\(String s, String t\) {) Tj T* (    if \(s.isEmpty\(\) || t.isEmpty\(\)\) return "";) Tj T* (    Map<Character, Integer> need = new HashMap<>\(\);) Tj T* (    for \(char c : t.toCharArray\(\)\) need.merge\(c, 1, Integer::sum\);) Tj T*  T* (    Map<Character, Integer> window = new HashMap<>\(\);) Tj T* (    int have = 0, needCount = need.size\(\);) Tj T* (    int left = 0, bestLen = Integer.MAX_VALUE, bestStart = 0;) Tj T*  T* (    for \(int right = 0; right < s.length\(\); right++\) {) Tj T* (        char c = s.charAt\(right\);) Tj T* (        window.merge\(c, 1, Integer::sum\);) Tj T* (        if \(need.containsKey\(c\) && window.get\(c\).intValue\(\) == need.get\(c\).intValue\(\)\) {) Tj T* (            have++; // this character's frequency requirement is now fully satisfied) Tj T* (        }) Tj T*  T* (        while \(have == needCount\) { // window is valid, try to shrink from the left) Tj T* (            if \(right - left + 1 < bestLen\) {) Tj T* (                bestLen = right - left + 1;) Tj T* (                bestStart = left;) Tj T* (            }) Tj T* (            char leftChar = s.charAt\(left\);) Tj T* (            window.put\(leftChar, window.get\(leftChar\) - 1\);) Tj T* (            if \(need.containsKey\(leftChar\) && window.get\(leftChar\) < need.get\(leftChar\)\) {) Tj T* (                have--; // shrinking broke the requirement for this character) Tj T* (            }) Tj T* (            left++;) Tj T* (        }) Tj T* (    }) Tj T* (    return bestLen == Integer.MAX_VALUE ? "" : s.substring\(bestStart, bestStart + bestLen\);) Tj T* (}) Tj T* ET
Q
