BT 1 0 0 1 6 114.8 Tm /F3 7.6 Tf 10.2 TL (public int minSubArrayLen\(int target, int[] nums\) {) Tj T* (    int left = 0, sum = 0, minLen = Integer.MAX_VALUE;) Tj T* (    for \(int right = 0; right < nums.length; right++\) {) Tj T* (        sum += nums[right];) Tj T* (        while \(sum >= target\) {  // shrink while still valid, to find the minimum) Tj T* (            minLen = Math.min\(minLen, right - left + 1\);) Tj T* (            sum -= nums[left];) Tj T* (            left++;) Tj T* (        }) Tj T* (    }) Tj T* (    return minLen == Integer.MAX_VALUE ? 0 : minLen;) Tj T* (}) Tj T* ET
