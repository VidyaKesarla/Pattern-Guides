BT 1 0 0 1 6 84.2 Tm /F4 7.6 Tf 10.2 TL (public int maxProfit\(int[] prices\) {) Tj T* (    int minPriceSoFar = Integer.MAX_VALUE;) Tj T* (    int maxProfit = 0;) Tj T* (    for \(int price : prices\) {) Tj T* (        minPriceSoFar = Math.min\(minPriceSoFar, price\); // greedy: track cheapest buy point) Tj T* (        maxProfit = Math.max\(maxProfit, price - minPriceSoFar\);) Tj T* (    }) Tj T* (    return maxProfit;) Tj T* (}) Tj T* ET
