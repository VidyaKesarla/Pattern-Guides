BT 1 0 0 1 6 74 Tm /F4 7.6 Tf 10.2 TL (public boolean canJump\(int[] nums\) {) Tj T* (    int farthestReachable = 0;) Tj T* (    for \(int i = 0; i < nums.length; i++\) {) Tj T* (        if \(i > farthestReachable\) return false; // stuck, can't even reach index i) Tj T* (        farthestReachable = Math.max\(farthestReachable, i + nums[i]\); // greedy: extend as far as possible) Tj T* (    }) Tj T* (    return true;) Tj T* (}) Tj T* ET
