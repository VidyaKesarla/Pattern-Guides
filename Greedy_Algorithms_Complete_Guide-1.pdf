BT 1 0 0 1 6 135.2 Tm /F4 7.6 Tf 10.2 TL (public int connectRopes\(int[] ropes\) {) Tj T* (    PriorityQueue<Integer> minHeap = new PriorityQueue<>\(\);) Tj T* (    for \(int r : ropes\) minHeap.offer\(r\);) Tj T*  T* (    int totalCost = 0;) Tj T* (    while \(minHeap.size\(\) > 1\) {) Tj T* (        int first = minHeap.poll\(\);) Tj T* (        int second = minHeap.poll\(\);) Tj T* (        int cost = first + second;) Tj T* (        totalCost += cost;) Tj T* (        minHeap.offer\(cost\); // greedy: always merge the two cheapest ropes first) Tj T* (    }) Tj T* (    return totalCost;) Tj T* (}) Tj T* ET
