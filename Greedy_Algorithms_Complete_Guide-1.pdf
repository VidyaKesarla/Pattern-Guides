BT 1 0 0 1 6 145.4 Tm /F4 7.6 Tf 10.2 TL (public int eraseOverlapIntervals\(int[][] intervals\) {) Tj T* (    if \(intervals.length == 0\) return 0;) Tj T* (    Arrays.sort\(intervals, \(a, b\) -> a[1] - b[1]\); // sort by END time) Tj T*  T* (    int count = 0;) Tj T* (    int lastEnd = intervals[0][1];) Tj T* (    for \(int i = 1; i < intervals.length; i++\) {) Tj T* (        if \(intervals[i][0] < lastEnd\) {) Tj T* (            count++; // overlap -> remove this interval \(greedy: keep the one ending earlier\)) Tj T* (        } else {) Tj T* (            lastEnd = intervals[i][1];) Tj T* (        }) Tj T* (    }) Tj T* (    return count;) Tj T* (}) Tj T* ET
