BT 1 0 0 1 4 54.8 Tm /F5 8.2 Tf 10.5 TL (public int maxDepth\(TreeNode root\) {) Tj T* (    if \(root == null\) return 0; // base case: empty tree has depth 0) Tj T* (    int leftDepth = maxDepth\(root.left\);   // trust this is correct \(leap of faith\)) Tj T* (    int rightDepth = maxDepth\(root.right\); // trust this is correct too) Tj T* (    return 1 + Math.max\(leftDepth, rightDepth\); // combine: this node + deeper subtree) Tj T* (}) Tj T* ET
