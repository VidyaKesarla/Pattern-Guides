BT 1 0 0 1 4 264.8 Tm /F5 8.2 Tf 10.5 TL (public int numIslands\(char[][] grid\) {) Tj T* (    int rows = grid.length, cols = grid[0].length;) Tj T* (    boolean[][] visited = new boolean[rows][cols];) Tj T* (    int count = 0;) Tj T*  T* (    for \(int r = 0; r < rows; r++\) {) Tj T* (        for \(int c = 0; c < cols; c++\) {) Tj T* (            if \(grid[r][c] == '1' && !visited[r][c]\) {) Tj T* (                dfsGrid\(grid, visited, r, c\);) Tj T* (                count++; // found a new island, explore all of it) Tj T* (            }) Tj T* (        }) Tj T* (    }) Tj T* (    return count;) Tj T* (}) Tj T*  T* (private void dfsGrid\(char[][] grid, boolean[][] visited, int r, int c\) {) Tj T* (    if \(r < 0 || r >= grid.length || c < 0 || c >= grid[0].length\) return;) Tj T* (    if \(visited[r][c] || grid[r][c] == '0'\) return;) Tj T* (    visited[r][c] = true;) Tj T*  T* (    dfsGrid\(grid, visited, r + 1, c\);) Tj T* (    dfsGrid\(grid, visited, r - 1, c\);) Tj T* (    dfsGrid\(grid, visited, r, c + 1\);) Tj T* (    dfsGrid\(grid, visited, r, c - 1\);) Tj T* (}) Tj T* ET
