BT 1 0 0 1 4 222.8 Tm /F5 8.2 Tf 10.5 TL (public List<List<Integer>> permute\(int[] nums\) {) Tj T* (    List<List<Integer>> result = new ArrayList<>\(\);) Tj T* (    backtrack\(nums, new ArrayList<>\(\), new boolean[nums.length], result\);) Tj T* (    return result;) Tj T* (}) Tj T*  T* (private void backtrack\(int[] nums, List<Integer> current, boolean[] used, List<List<Integer>> result\) {) Tj T* (    if \(current.size\(\) == nums.length\) {) Tj T* (        result.add\(new ArrayList<>\(current\)\); // copy - current will keep mutating) Tj T* (        return;) Tj T* (    }) Tj T* (    for \(int i = 0; i < nums.length; i++\) {) Tj T* (        if \(used[i]\) continue;) Tj T* (        used[i] = true;) Tj T* (        current.add\(nums[i]\);) Tj T*  T* (        backtrack\(nums, current, used, result\); // explore) Tj T*  T* (        current.remove\(current.size\(\) - 1\); // undo \(the "back" in backtracking\)) Tj T* (        used[i] = false;) Tj T* (    }) Tj T* (}) Tj T* ET
