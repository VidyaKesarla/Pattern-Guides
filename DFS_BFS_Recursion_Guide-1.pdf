BT 1 0 0 1 4 243.8 Tm /F5 8.2 Tf 10.5 TL (public int bfsShortestPath\(int start, int target, Map<Integer, List<Integer>> graph\) {) Tj T* (    Set<Integer> visited = new HashSet<>\(\);) Tj T* (    Queue<Integer> queue = new LinkedList<>\(\);) Tj T* (    queue.offer\(start\);) Tj T* (    visited.add\(start\);) Tj T* (    int steps = 0;) Tj T*  T* (    while \(!queue.isEmpty\(\)\) {) Tj T* (        int size = queue.size\(\); // process one full level at a time) Tj T* (        for \(int i = 0; i < size; i++\) {) Tj T* (            int node = queue.poll\(\);) Tj T* (            if \(node == target\) return steps;) Tj T*  T* (            for \(int neighbor : graph.getOrDefault\(node, new ArrayList<>\(\)\)\) {) Tj T* (                if \(!visited.contains\(neighbor\)\) {) Tj T* (                    visited.add\(neighbor\);) Tj T* (                    queue.offer\(neighbor\);) Tj T* (                }) Tj T* (            }) Tj T* (        }) Tj T* (        steps++; // moved to the next level/distance) Tj T* (    }) Tj T* (    return -1; // target not reachable) Tj T* (}) Tj T* ET
