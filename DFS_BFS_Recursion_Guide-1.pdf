BT 1 0 0 1 4 317.3 Tm /F5 8.2 Tf 10.5 TL (public int multiSourceBFS\(int[][] grid\) {) Tj T* (    int rows = grid.length, cols = grid[0].length;) Tj T* (    Queue<int[]> queue = new LinkedList<>\(\);) Tj T* (    int freshCount = 0;) Tj T*  T* (    for \(int r = 0; r < rows; r++\) {) Tj T* (        for \(int c = 0; c < cols; c++\) {) Tj T* (            if \(grid[r][c] == 2\) queue.offer\(new int[]{r, c}\); // seed ALL sources at once) Tj T* (            else if \(grid[r][c] == 1\) freshCount++;) Tj T* (        }) Tj T* (    }) Tj T*  T* (    int minutes = 0;) Tj T* (    int[][] dirs = {{1,0},{-1,0},{0,1},{0,-1}};) Tj T* (    while \(!queue.isEmpty\(\) && freshCount > 0\) {) Tj T* (        int size = queue.size\(\);) Tj T* (        for \(int i = 0; i < size; i++\) {) Tj T* (            int[] cell = queue.poll\(\);) Tj T* (            for \(int[] d : dirs\) {) Tj T* (                int nr = cell[0] + d[0], nc = cell[1] + d[1];) Tj T* (                if \(nr >= 0 && nr < rows && nc >= 0 && nc < cols && grid[nr][nc] == 1\) {) Tj T* (                    grid[nr][nc] = 2;) Tj T* (                    freshCount--;) Tj T* (                    queue.offer\(new int[]{nr, nc}\);) Tj T* (                }) Tj T* (            }) Tj T* (        }) Tj T* (        minutes++;) Tj T* (    }) Tj T* (    return freshCount == 0 ? minutes : -1; // -1 if some fresh cells unreachable) Tj T* (}) Tj T* ET
