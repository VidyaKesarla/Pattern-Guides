BT 1 0 0 1 4 159.8 Tm /F5 8.2 Tf 10.5 TL (public void dfsIterative\(int start, Map<Integer, List<Integer>> graph\) {) Tj T* (    Set<Integer> visited = new HashSet<>\(\);) Tj T* (    Deque<Integer> stack = new ArrayDeque<>\(\);) Tj T* (    stack.push\(start\);) Tj T*  T* (    while \(!stack.isEmpty\(\)\) {) Tj T* (        int node = stack.pop\(\);) Tj T* (        if \(visited.contains\(node\)\) continue;) Tj T* (        visited.add\(node\);) Tj T* (        // process\(node\) here) Tj T*  T* (        for \(int neighbor : graph.getOrDefault\(node, new ArrayList<>\(\)\)\) {) Tj T* (            if \(!visited.contains\(neighbor\)\) stack.push\(neighbor\);) Tj T* (        }) Tj T* (    }) Tj T* (}) Tj T* ET
